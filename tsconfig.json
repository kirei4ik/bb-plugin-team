{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "noEmit": true,
    "skipLibCheck": false,
    "jsx": "react-jsx"
  },
  "include": [
    "server.ts",
    "app.tsx",
    "core.ts",
    "strings.ts",
    "snapshot.ts",
    "tasks.ts",
    "report.ts",
    "messages.ts",
    "templates.ts"
  ]
}
